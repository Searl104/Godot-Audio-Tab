[configuration]

entry_symbol = "aw_engine_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/audio_workstation/bin/libawengine.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/audio_workstation/bin/libawengine.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/audio_workstation/bin/libawengine.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/audio_workstation/bin/libawengine.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://addons/audio_workstation/bin/libawengine.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/audio_workstation/bin/libawengine.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://addons/audio_workstation/bin/libawengine.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://addons/audio_workstation/bin/libawengine.windows.template_release.arm64.dll"
macos.debug = "res://addons/audio_workstation/bin/libawengine.macos.template_debug.framework"
macos.release = "res://addons/audio_workstation/bin/libawengine.macos.template_release.framework"
