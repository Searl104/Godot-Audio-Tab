#!/usr/bin/env python
# Builds the Audio Workstation engine (GDExtension) into addons/audio_workstation/bin/.
#
#   scons                              # Linux/Windows/macOS debug build for the editor
#   scons target=template_release      # release build (used by exported games)
#   scons platform=windows             # cross-compile (MinGW) or build on Windows (MSVC)
#
# godot-cpp is pinned to 10.0.0-stable and compiled against the Godot 4.7 API.

import os

GODOT_CPP_TAG = "10.0.0-stable"
if not os.path.isfile("godot-cpp/SConstruct"):
    raise SystemExit(
        "godot-cpp is missing. Run:\n"
        "  git clone --depth 1 --branch %s https://github.com/godotengine/godot-cpp.git extension/godot-cpp" % GODOT_CPP_TAG
    )

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

# Our own sources get a clone of the environment, so the version defines below don't change the
# godot-cpp command lines (changing them would rebuild all of godot-cpp, minutes of work).
aw_env = env.Clone()
aw_env.Append(CPPPATH=["src/"])
aw_env.Append(CPPDEFINES=[("AW_ENGINE_VERSION", '\\"0.13.0\\"'), ("AW_GODOT_CPP", '\\"%s\\"' % GODOT_CPP_TAG)])
sources = Glob("src/*.cpp")

# Vendored libogg / libvorbis (encoder side only), see thirdparty/README.md. Plain C, built with
# their own include paths and without our warnings settings.
c_env = aw_env.Clone()
c_env.Append(CPPPATH=["thirdparty/ogg/include", "thirdparty/vorbis/include", "thirdparty/vorbis/lib"])
aw_env.Append(CPPPATH=["thirdparty/ogg/include", "thirdparty/vorbis/include"])
VORBIS_FILES = ["analysis", "bitrate", "block", "codebook", "envelope", "floor0", "floor1", "info", "lookup",
                "lpc", "lsp", "mapping0", "mdct", "psy", "registry", "res0", "sharedbook", "smallft",
                "synthesis", "vorbisenc", "window"]
for f in VORBIS_FILES:
    sources.append(c_env.SharedObject("thirdparty/vorbis/lib/%s.c" % f))
for f in ["bitwise", "framing"]:
    sources.append(c_env.SharedObject("thirdparty/ogg/src/%s.c" % f))

ADDON = "../addons/audio_workstation/"
BIN = ADDON + "bin/"

if env["platform"] == "macos":
    library = aw_env.SharedLibrary(
        BIN + "libawengine.macos.{0}.framework/libawengine.macos.{0}".format(env["target"]),
        source=sources,
    )
else:
    library = aw_env.SharedLibrary(BIN + "libawengine{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)

# The .gdextension file is only installed by a build, so an unbuilt checkout never asks
# Godot to load a library that isn't there (the plugin then shows "Engine not built").
manifest = env.Command(ADDON + "aw_engine.gdextension", "aw_engine.gdextension", Copy("$TARGET", "$SOURCE"))

aw_env.NoCache(library)
Default(library, manifest)
